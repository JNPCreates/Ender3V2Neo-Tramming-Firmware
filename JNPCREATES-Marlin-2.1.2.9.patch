+/** Smart Tramming scan controller. SPDX-License-Identifier: GPL-3.0-or-later */
+#pragma once
+
+#ifndef SMART_TRAMMING_HOST
+  #include "../inc/MarlinConfigPre.h"
+#endif
+
+#if ENABLED(SMART_BED_TRAMMING)
+
+#include "smart_tramming_types.h"
+
+namespace smart_tramming {
+  // Fixed probe-tip positions (SMART_TRAMMING_POINTS), FL, FR, BR, BL.
+  extern const Point positions[4];
+  extern Session session;
+  extern bool heat_before_level;   // Leveling menu checkbox (saved in EEPROM)
+  bool busy();
+  void begin();
+  void select_corner(uint8_t corner);
+  bool valid_points(const Point *positions);
+  bool points_reachable();   // With the active probe offsets and travel limits
+  bool request_scan();
+  void cancel();
+  void execute_scan(); // Only called through the command queue, never LCD idle.
+  void finish();
+  void end();          // Leaving Bed Tramming: Z must be re-homed before printing
+  const char *corner_name(uint8_t corner);
+}
+
+#endif
diff --git a/Marlin/src/feature/smart_tramming_draw.h b/Marlin/src/feature/smart_tramming_draw.h
new file mode 100644
index 0000000..ae48564
--- /dev/null
+++ b/Marlin/src/feature/smart_tramming_draw.h
@@ -0,0 +1,63 @@
+/** Bounded, incremental LCD drawing. SPDX-License-Identifier: GPL-3.0-or-later */
+#pragma once
+#include <stdint.h>
+#include <string.h>
+#include <stdlib.h>
+
+namespace smart_tramming {
+  struct DrawCommand {
+    enum Kind : uint8_t { Rectangle, Text, Line } kind;
+    bool fill;
+    uint16_t color, x0, y0, x1, y1;
+    char label[33];
+  };
+
+  class DrawQueue {
+    static constexpr uint16_t capacity = 192;
+    DrawCommand commands[capacity];
+    uint16_t count = 0, cursor = 0;
+    bool overflowed = false, line_active = false;
+    int x, y, dx, dy, sx, sy, error;
+  public:
+    void clear() { count=cursor=0; overflowed=line_active=false; }
+    bool pending() const { return cursor<count; }
+    bool overflow() const { return overflowed; }
+    void add(DrawCommand::Kind kind,bool fill,uint16_t color,uint16_t x0,uint16_t y0,
+             uint16_t x1,uint16_t y1,const char *label=nullptr) {
+      if(cursor==count&&!line_active)count=cursor=0;   // Fully drawn: reuse the space (live updates)
+      if(count==capacity){overflowed=true;return;}
+      DrawCommand &c=commands[count++];
+      c.kind=kind;c.fill=fill;c.color=color;c.x0=x0;c.y0=y0;c.x1=x1;c.y1=y1;
+      if(label){strncpy(c.label,label,32);c.label[32]='\0';}else c.label[0]='\0';
+    }
+    bool next(DrawCommand &out) {
+      if(!pending())return false;
+      const DrawCommand &c=commands[cursor];
+      if(c.kind!=DrawCommand::Line){out=c;++cursor;return true;}
+      out=c;out.kind=DrawCommand::Rectangle;out.fill=true;out.label[0]='\0';
+      if(c.x0==c.x1||c.y0==c.y1){
+        out.x0=c.x0<c.x1?c.x0:c.x1;out.x1=c.x0<c.x1?c.x1:c.x0;
+        out.y0=c.y0<c.y1?c.y0:c.y1;out.y1=c.y0<c.y1?c.y1:c.y0;
+        ++cursor;return true;
+      }
+      // Expand each diagonal into horizontal pixel runs, one per render tick.
+      // TJC receives ordinary rectangles rather than a burst of diagonal commands.
+      if(!line_active){
+        x=c.x0;y=c.y0;dx=abs(int(c.x1)-x);dy=-abs(int(c.y1)-y);
+        sx=x<int(c.x1)?1:-1;sy=y<int(c.y1)?1:-1;error=dx+dy;line_active=true;
+      }
+      const int first=x,row=y;
+      int last=x;
+      for(;;){
+        last=x;
+        if(x==int(c.x1)&&y==int(c.y1)){line_active=false;++cursor;break;}
+        const int twice=2*error;
+        if(twice>=dy){error+=dy;x+=sx;}
+        if(twice<=dx){error+=dx;y+=sy;}
+        if(y!=row)break;
+      }
+      out.x0=first<last?first:last;out.x1=first<last?last:first;out.y0=out.y1=row;
+      return true;
+    }
+  };
+}
diff --git a/Marlin/src/feature/smart_tramming_math.h b/Marlin/src/feature/smart_tramming_math.h
new file mode 100644
index 0000000..6934fbf
--- /dev/null
+++ b/Marlin/src/feature/smart_tramming_math.h
@@ -0,0 +1,69 @@
+/**
+ * Smart Tramming calculations. SPDX-License-Identifier: GPL-3.0-or-later
+ * Independent of motion and LCD so numerical behavior can be tested on a host.
+ */
+#pragma once
+
+#include <stdint.h>
+#include <math.h>
+
+namespace smart_tramming {
+
+  enum class Severity : uint8_t { Unknown, Acceptable, Minor, Significant };
+
+  struct Summary {
+    bool valid = false, complete = false;
+    float relative_mm[4] = {}, correction_mm[4] = {}, degrees[4] = {};
+    Severity severity[4] = { Severity::Unknown, Severity::Unknown, Severity::Unknown, Severity::Unknown };
+    float spread_mm = NAN;
+    float target_mm = NAN;
+    uint8_t adjust = 255;   // The one corner to adjust next (largest deviation), 255 = none
+  };
+
+  // Allow only a sub-micron float rounding margin, not a measurement tolerance.
+  inline bool within(const float value, const float limit) { return value <= limit + 0.000001f; }
+
+  inline Summary summarize(const float heights[4], const float tolerance, const float minor_threshold,
+                           const float pitch_mm) {
+    Summary out;
+    if (!isfinite(tolerance) || tolerance <= 0
+        || !isfinite(minor_threshold) || minor_threshold < tolerance) return out;
+    for (uint8_t i = 0; i < 4; ++i)
+      if (!isfinite(heights[i])) return out;
+
+    float low = heights[0], high = heights[0];
+    float mean = 0;
+    for (uint8_t i = 0; i < 4; ++i) mean += heights[i] * 0.25f;
+    if (!isfinite(mean)) return out;
+    out.target_mm = mean;
+    for (uint8_t i = 0; i < 4; ++i) {
+      if (heights[i] < low) low = heights[i];
+      if (heights[i] > high) high = heights[i];
+      const float delta = heights[i] - mean, magnitude = fabsf(delta);
+      if (!isfinite(delta)) return Summary{};
+      out.relative_mm[i] = delta;
+      out.correction_mm[i] = -delta; // Positive means raise the bed.
+      out.degrees[i] = isfinite(pitch_mm) && pitch_mm > 0 ? magnitude / pitch_mm * 360.0f : NAN;
+      if (!isfinite(out.degrees[i])) out.degrees[i] = NAN;
+      out.severity[i] = within(magnitude, tolerance * 0.5f) ? Severity::Acceptable
+                     : within(magnitude, minor_threshold) ? Severity::Minor : Severity::Significant;
+    }
+    out.spread_mm = high - low;
+    if (!isfinite(out.spread_mm)) return Summary{};
+    out.complete = within(out.spread_mm, tolerance);
+    if (out.complete) for (uint8_t i = 0; i < 4; ++i) out.severity[i] = Severity::Acceptable;
+    else {
+      // One knob at a time: only the corner furthest from the target gets an instruction.
+      for (uint8_t i = 0; i < 4; ++i)
+        if (out.severity[i] != Severity::Acceptable
+            && (out.adjust == 255 || fabsf(out.relative_mm[i]) > fabsf(out.relative_mm[out.adjust])))
+          out.adjust = i;
+    }
+    out.valid = true;
+    return out;
+  }
+
+  inline bool clockwise_for_correction(const float correction_mm, const bool cw_raises_bed) {
+    return (correction_mm > 0) == cw_raises_bed;
+  }
+}
