diff --git a/Marlin/SmartTramming.h b/Marlin/SmartTramming.h
new file mode 100644
index 0000000..20025d3
--- /dev/null
+++ b/Marlin/SmartTramming.h
@@ -0,0 +1,47 @@
+/**
+ * Smart Ender-3 V2 Neo settings. SPDX-License-Identifier: GPL-3.0-or-later
+ */
+#pragma once
+
+#define SMART_BED_TRAMMING
+
+// Owner-reported Gen 4 AIHM17 (TJC). The custom pages use 8x16 ASCII text and
+// rectangles only; diagonal lines are sent as pixel-row rectangles.
+#define TJC_DISPLAY
+
+// Retain the printer's factory display assets. Library 7 belongs to Marlin's
+// optional unified asset package; stock Creality panels use library 9.
+#define USE_STOCK_DWIN_SET
+
+// This header is included by Configuration_adv.h, after Conditionals_LCD.h.
+// Override that older upstream version's generic brightness range for TJC.
+#undef LCD_BRIGHTNESS_MAX
+#define LCD_BRIGHTNESS_MIN 6
+#define LCD_BRIGHTNESS_MAX 40
+#define LCD_BRIGHTNESS_DEFAULT 20
+
+// Fixed probe-tip positions, FL, FR, BR, BL (machine coordinates, NOT nozzle).
+// Centered on the measured plate center X=120 (edges at X=3 / X=237): 32 mm in from
+// each side. FR/BR need nozzle X = 205+39 = 244 = X_MAX_POS. Y 25 / 205.
+// Every scan re-checks reachability with the active probe offsets.
+#define SMART_TRAMMING_POINTS { { 35, 25 }, { 205, 25 }, { 205, 205 }, { 35, 205 } }
+#define SMART_TRAMMING_TOLERANCE_MM       0.05f
+#define SMART_TRAMMING_MINOR_MM           0.10f
+#define SMART_TRAMMING_CLEARANCE_MM       5.0f   // = Z_CLEARANCE_BETWEEN_PROBES
+
+// After measuring, park the nozzle at this Y so the bed comes forward (owner-chosen).
+#define SMART_TRAMMING_PARK_X             120   // plate center
+#define SMART_TRAMMING_PARK_Y             222   // Y_MAX_POS is 225
+
+// Bed screws: M4 x 0.7 (stock Ender-3 V2 / Neo). Degrees = 360 * correction / pitch.
+// Set to 0 to hide degree estimates.
+#define SMART_TRAMMING_SCREW_PITCH_MM     0.7f
+
+// Knob direction as the owner turns it: looking DOWN at the knob from above.
+// Confirmed on the printer 2026-11-07: from above, clockwise RAISES the corner.
+#define SMART_TRAMMING_DIRECTION_CONFIRMED 1
+#define SMART_TRAMMING_CW_RAISES_BED      1
+
+// Owner's X home offset (M206 X): G-code X0 sits 2 mm onto the plate. Applied when
+// settings are reset to defaults (e.g. after a firmware update changes the layout).
+#define JNP_DEFAULT_HOME_OFFSET_X         -5
diff --git a/Marlin/src/feature/smart_tramming.cpp b/Marlin/src/feature/smart_tramming.cpp
new file mode 100644
index 0000000..d6f35ce
--- /dev/null
+++ b/Marlin/src/feature/smart_tramming.cpp
@@ -0,0 +1,242 @@
+/** Smart Tramming scan controller. SPDX-License-Identifier: GPL-3.0-or-later */
+#ifdef SMART_TRAMMING_HOST
+  #include "../../../tests/smart_tramming_mocks.h"
+#else
+  #include "../inc/MarlinConfig.h"
+#endif
+
+#if ENABLED(SMART_BED_TRAMMING)
+
+#if !HAS_BED_PROBE || DISABLED(DWIN_CREALITY_LCD) || !IS_CARTESIAN
+  #error "Smart Tramming currently requires a Cartesian printer, bed probe and Creality LCD UI."
+#endif
+
+#include "smart_tramming.h"
+#ifndef SMART_TRAMMING_HOST
+#include "../MarlinCore.h"
+#include "../gcode/gcode.h"
+#include "../gcode/queue.h"
+#include "../module/motion.h"
+#include "../module/planner.h"
+#include "../module/probe.h"
+#include "../module/temperature.h"
+#include "../lcd/marlinui.h"
+#include "bedlevel/bedlevel.h"
+#endif
+
+static_assert(SMART_TRAMMING_TOLERANCE_MM > 0, "Tramming tolerance must be positive.");
+static_assert(SMART_TRAMMING_MINOR_MM >= SMART_TRAMMING_TOLERANCE_MM, "Invalid tramming color thresholds.");
+static_assert(SMART_TRAMMING_CLEARANCE_MM >= Z_CLEARANCE_BETWEEN_PROBES, "Insufficient tramming clearance.");
+static_assert(SMART_TRAMMING_SCREW_PITCH_MM >= 0, "Pitch must be positive or zero (unknown).");
+static_assert(SMART_TRAMMING_PARK_Y <= Y_MAX_POS, "Park Y beyond Y travel.");
+
+namespace smart_tramming {
+  Session session;
+  const Point positions[4] = SMART_TRAMMING_POINTS;
+  bool heat_before_level = false;
+
+  static xy_pos_t native_point(const Point &point) { return xy_pos_t { point.x, point.y }; }
+
+  bool valid_points(const Point *pts) {
+    for (uint8_t i = 0; i < 4; ++i) {
+      if (!isfinite(pts[i].x) || !isfinite(pts[i].y) || !probe.can_reach(native_point(pts[i]))) return false;
+      for (uint8_t j = 0; j < i; ++j)
+        if (fabsf(pts[i].x - pts[j].x) < 0.001f && fabsf(pts[i].y - pts[j].y) < 0.001f) return false;
+    }
+    return pts[0].x < pts[1].x && pts[3].x < pts[2].x
+      && pts[0].y < pts[3].y && pts[1].y < pts[2].y;
+  }
+
+  bool points_reachable() { return valid_points(positions); }
+
+  const char *corner_name(const uint8_t corner) {
+    static const char * const names[] = { "Front Left", "Front Right", "Back Right", "Back Left" };
+    return corner < 4 ? names[corner] : "Unknown";
+  }
+
+  bool busy() {
+    return session.stage == Stage::Queued || session.stage == Stage::Heating
+        || session.stage == Stage::Homing || session.stage == Stage::Probing;
+  }
+
+  static void invalidate() {
+    session.summary = Summary{};
+    session.measured_count = 0;
+    for (float &height : session.heights) height = NAN;
+  }
+
+  static void fail(const char *message) {
+    invalidate(); // Never offer adjustments from an incomplete/failed scan.
+    session.error = message;
+    session.stage = Stage::Error;
+    ++session.revision;
+  }
+
+  void begin() {
+    if (busy()) return;
+    session = Session{};
+  }
+
+  void select_corner(const uint8_t corner) {
+    if (busy() || corner >= 4) return;
+    session.selected_corner = corner;
+    if (session.summary.valid) {
+      session.summary = summarize(session.heights,
+        SMART_TRAMMING_TOLERANCE_MM, SMART_TRAMMING_MINOR_MM, SMART_TRAMMING_SCREW_PITCH_MM);
+      session.stage = Stage::Results;
+    }
+    else {
+      invalidate();
+      session.stage = Stage::Ready;
+    }
+    ++session.revision;
+  }
+
+  bool request_scan() {
+    if (busy()) return false;
+    invalidate();
+    session.error = nullptr;
+    session.cancel_requested = false;
+    if (!IsRunning() || printJobOngoing() || printingIsPaused()
+        || planner.has_blocks_queued() || queue.has_commands_queued()) {
+      fail("Printer must be idle"); return false;
+    }
+    if (!points_reachable()) { fail("Probe can't reach a corner"); return false; }
+    session.stage = Stage::Queued;
+    ++session.revision;
+    if (!queue.enqueue_one(F("G36"))) { fail("Command queue is busy"); return false; }
+    return true;
+  }
+
+  void cancel() {
+    if (busy()) {
+      session.cancel_requested = true;
+      #ifndef SMART_TRAMMING_HOST
+        if (session.stage == Stage::Heating) wait_for_heatup = false;   // break M190-style wait
+      #endif
+      if (session.stage == Stage::Queued) session.stage = Stage::Cancelled;
+      ++session.revision;
+    }
+  }
+
+  void execute_scan() {
+    // G36 is a project-local queue entry point, not a host-triggered scan API.
+    if (session.stage != Stage::Queued) return;
+    if (session.cancel_requested) {
+      session.stage = Stage::Cancelled;
+      ++session.revision;
+      return;
+    }
+    if (!IsRunning() || printJobOngoing() || printingIsPaused() || !points_reachable()) {
+      fail("Scan preconditions changed"); return;
+    }
+    planner.synchronize();
+    TERN_(HAS_LEVELING, set_bed_leveling_enabled(false));
+    // G28 also uses the global feedrate save slot, so keep our own copy.
+    const feedRate_t entry_feedrate = feedrate_mm_s;
+    const int16_t entry_percentage = feedrate_percentage;
+    feedrate_percentage = 100;
+
+    #if !defined(SMART_TRAMMING_HOST) && HAS_HEATED_BED && HAS_PREHEAT
+      if (heat_before_level) {   // Tram at printing temperature (PLA preheat bed temp)
+        session.stage = Stage::Heating;
+        ++session.revision;
+        thermalManager.setTargetBed(ui.material_preset[0].bed_temp);
+        thermalManager.wait_for_bed(true);   // idle() keeps the LCD and Cancel responsive
+        if (session.cancel_requested || !IsRunning()) {
+          feedrate_mm_s = entry_feedrate; feedrate_percentage = entry_percentage;
+          invalidate(); session.stage = Stage::Cancelled; ++session.revision; return;
+        }
+      }
+    #endif
+    // Home only when needed. All four corners are compared within one pass, so a
+    // knob turn between passes does not need a new Z reference.
+    if (!all_axes_trusted()) {
+      session.stage = Stage::Homing;
+      ++session.revision;
+      gcode.process_subcommands_now(F("G28"));
+      TERN_(HAS_LEVELING, set_bed_leveling_enabled(false));
+    }
+    bool failed = !IsRunning() || !all_axes_trusted();
+    if (failed) session.error = "Homing did not complete";
+
+    for (uint8_t i = 0; i < 4 && !failed && !session.cancel_requested; ++i) {
+      // EEPROM/runtime offsets and homing can change reachability.
+      const xy_pos_t point = native_point(positions[i]);
+      if (!probe.can_reach(point)) {
+        session.error = "Probe can't reach a corner";
+        failed = true;
+        break;
+      }
+      session.stage = Stage::Probing;
+      ++session.revision;
+      // Raise only. Never lower to an absolute clearance after a failed probe.
+      do_blocking_move_to_z(_MIN(float(Z_MAX_POS), _MAX(current_position.z, float(SMART_TRAMMING_CLEARANCE_MM))));
+      if (!IsRunning() || !all_axes_trusted()) {
+        session.error = "Printer stopped during scan";
+        failed = true;
+        break;
+      }
+      if (session.cancel_requested) break;
+      // Keep the CR Touch deployed between corners (as G29/G35); stow after the last one.
+      const float z = probe.probe_at_point(point, i < 3 ? PROBE_PT_RAISE : PROBE_PT_STOW, 0, true);
+      if (!isfinite(z) || !IsRunning() || !all_axes_trusted()) {
+        session.error = "Probe failed; check CR Touch";
+        failed = true;
+        break;
+      }
+      session.heights[i] = z;
+      ++session.measured_count;
+      ++session.revision;
+    }
+
+    // Stow and park only when the printer still permits motion.
+    if (IsRunning() && all_axes_trusted()) {
+      if (probe.stow()) {
+        failed = true;
+        session.error = "CR Touch could not stow";
+      }
+      if (!failed && all_axes_trusted()) {
+        do_blocking_move_to_z(_MIN(float(Z_MAX_POS), _MAX(current_position.z, float(SMART_TRAMMING_CLEARANCE_MM))));
+        // Bed forward (nozzle near max Y), so all four knobs are easy to reach.
+        if (IsRunning() && all_axes_trusted())
+          do_blocking_move_to_xy(SMART_TRAMMING_PARK_X, SMART_TRAMMING_PARK_Y, feedRate_t(XY_PROBE_FEEDRATE_MM_S));
+      }
+    }
+    if (!IsRunning()) {
+      failed = true;
+      session.error = "Printer stopped during scan";
+    }
+    feedrate_mm_s = entry_feedrate;
+    feedrate_percentage = entry_percentage;
+    // Keep mesh OFF: turning wheels invalidates its relationship to the bed.
+    // Z trust is released in end(), when the user leaves Bed Tramming.
+
+    if (failed) fail(session.error ? session.error : "Measurement failed");
+    else if (session.cancel_requested) {
+      invalidate();
+      session.stage = Stage::Cancelled;
+    }
+    else {
+      session.summary = summarize(session.heights,
+        SMART_TRAMMING_TOLERANCE_MM, SMART_TRAMMING_MINOR_MM, SMART_TRAMMING_SCREW_PITCH_MM);
+      if (!session.summary.valid) fail("Invalid measurement data");
+      else session.stage = Stage::Results;
+    }
+    ++session.revision;
+    ui.set_status(F("Tramming: rebuild mesh before print"));
+  }
+
+  void end() {
+    // Knob turns moved the bed: force a fresh Z home before anything else uses Z.
+    if (!busy()) set_axis_never_homed(Z_AXIS);
+  }
+
+  void finish() {
+    if (session.stage == Stage::Results && session.summary.valid && session.summary.complete) {
+      session.stage = Stage::Complete;
+      ++session.revision;
+    }
+  }
+}
+#endif
