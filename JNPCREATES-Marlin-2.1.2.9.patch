diff --git a/Marlin/src/lcd/e3v2/common/dwin_text.h b/Marlin/src/lcd/e3v2/common/dwin_text.h
new file mode 100644
index 0000000..afac08d
--- /dev/null
+++ b/Marlin/src/lcd/e3v2/common/dwin_text.h
@@ -0,0 +1,36 @@
+/** Text numbers for TJC panels. SPDX-License-Identifier: GPL-3.0-or-later */
+#pragma once
+#include <stdint.h>
+#include <stdio.h>
+#include <string.h>
+
+namespace dwin_text {
+  // Preserve the existing API's fixed-point units and field alignment without
+  // sending its 0x14 numeric command. No floating-point printf dependency.
+  inline void format(char *out, const size_t capacity, const uint32_t magnitude,
+                     const bool negative, const uint8_t whole_digits, const uint8_t decimals,
+                     const bool pad, const bool zero_pad) {
+    if (!capacity) return;
+    if (decimals > 9 || whole_digits > 10) {
+      snprintf(out, capacity, "?");
+      return;
+    }
+    uint32_t divisor = 1;
+    for (uint8_t n = 0; n < decimals; ++n) divisor *= 10;
+    char digits[24];
+    if (decimals)
+      snprintf(digits, sizeof(digits), "%lu.%0*lu", (unsigned long)(magnitude / divisor),
+               int(decimals), (unsigned long)(magnitude % divisor));
+    else
+      snprintf(digits, sizeof(digits), "%lu", (unsigned long)magnitude);
+    const size_t length = strlen(digits), width = whole_digits + (decimals ? decimals + 1 : 0);
+    const size_t padding = pad && width > length ? width - length : 0;
+    size_t used = 0;
+    // The sign precedes zero padding, but follows space padding.
+    if (negative && zero_pad && used + 1 < capacity) out[used++] = '-';
+    for (size_t n = 0; n < padding && used + 1 < capacity; ++n) out[used++] = zero_pad ? '0' : ' ';
+    if (negative && !zero_pad && used + 1 < capacity) out[used++] = '-';
+    for (size_t n = 0; n < length && used + 1 < capacity; ++n) out[used++] = digits[n];
+    out[used] = '\0';
+  }
+}
