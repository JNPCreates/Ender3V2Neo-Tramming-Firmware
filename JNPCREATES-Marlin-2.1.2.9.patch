diff --git a/Marlin/src/feature/smart_tramming_view.cpp b/Marlin/src/feature/smart_tramming_view.cpp
new file mode 100644
index 0000000..d9d3ee0
--- /dev/null
+++ b/Marlin/src/feature/smart_tramming_view.cpp
@@ -0,0 +1,149 @@
+/** Independent measured-Z tramming dashboard. SPDX-License-Identifier: GPL-3.0-or-later */
+#ifdef SMART_TRAMMING_HOST
+  #define SMART_TRAMMING_VIEW_ENABLED
+#else
+  #include "../inc/MarlinConfig.h"
+  #if ENABLED(SMART_BED_TRAMMING)
+    #define SMART_TRAMMING_VIEW_ENABLED
+  #endif
+#endif
+#ifdef SMART_TRAMMING_VIEW_ENABLED
+#include "smart_tramming_view.h"
+#include "../lcd/e3v2/common/jnp_theme.h"
+#include <stdio.h>
+#include <stdlib.h>
+#include <string.h>
+
+namespace smart_tramming {
+  namespace {
+    constexpr uint16_t bg=jnp_theme::background, panel=jnp_theme::panel, ink=jnp_theme::ink, dim=jnp_theme::muted,
+      accent=jnp_theme::accent, green=jnp_theme::green, yellow=jnp_theme::yellow, red=jnp_theme::red;
+    const char *name(const uint8_t i) {
+      const char * const names[]={"Front Left","Front Right","Back Right","Back Left"}; return names[i];
+    }
+    uint16_t color(const Severity grade) {
+      return grade==Severity::Acceptable?green:grade==Severity::Minor?yellow:grade==Severity::Significant?red:dim;
+    }
+    void mm(char *buffer,const size_t size,const float value,const bool sign=false) {
+      if(!isfinite(value)||fabsf(value)>=100){snprintf(buffer,size,"--.---");return;}
+      const unsigned n=unsigned(lroundf(fabsf(value)*1000));
+      const uint16_t whole=n/1000;
+      snprintf(buffer,size,"%s%u.%03u",value<-.0005f?"-":sign?"+":"",unsigned(whole),n%1000);
+    }
+    // Knob indicator: square outline (2 px) with an arrowhead on the top edge.
+    // Arrow right = clockwise, left = counterclockwise. About 7 rectangle commands,
+    // instead of ~90 pixel rows for a circle - fast and safe on the TJC panel.
+    void knob_box(const Surface &s,const int x,const int y,const uint16_t c,const bool arrow,const bool cw) {
+      constexpr int h=21;
+      s.rectangle(false,c,x-h,y-h,x+h,y+h);
+      s.rectangle(false,c,x-h+1,y-h+1,x+h-1,y+h-1);
+      if(arrow) for(int i=0;i<5;i++){
+        const int col=cw?x+4+i:x-4-i;            // tip points the way to turn
+        s.rectangle(true,c,col,y-h-(4-i),col,y-h+(4-i));
+      }
+    }
+    void button(const Surface &s,const int x,const char *label,const bool selected) {
+      s.rectangle(true,selected?accent:panel,x,319,x+119,349);s.text(selected?bg:ink,x+8,326,label);
+    }
+  }
+
+  void draw_menu(const Surface &s,const MenuView &view) {
+    s.rectangle(true,bg,0,0,271,353);s.rectangle(true,jnp_theme::title,0,0,271,30);
+    const bool paper=view.page==1;
+    s.text(ink,12,7,paper?"Paper Leveling":"Leveling");
+    const char *leveling[MENU_ITEMS]={"Back","Bed Tramming","Auto Mesh (5x5)","View Mesh",
+      view.heat_before_level?"[X] Heat bed first":"[ ] Heat bed first","Paper Leveling  >","Probe Accuracy Test"};
+    const char *corners[MENU_ITEMS]={"Back","Home","Front Left","Front Right","Back Right","Back Left","Center"};
+    const char * const *items=paper?corners:leveling;
+    for(uint8_t i=0;i<MENU_ITEMS;i++){
+      const uint16_t y=36+i*34;
+      s.rectangle(true,i==view.selected?panel:bg,8,y,263,y+30);
+      s.text(i==view.selected?accent:ink,14,y+7,items[i]);
+    }
+    s.text(dim,12,284,view.notice);
+    s.text(dim,12,308,paper?"Nozzle to Z0 over each knob":"Tram first, then Auto Mesh");
+  }
+
+  static void draw_footer(const Surface &s,const Session &state,const uint8_t selected,const ViewSettings &settings) {
+    const bool busy=state.stage==Stage::Queued||state.stage==Stage::Heating||state.stage==Stage::Homing||state.stage==Stage::Probing;
+    const bool valid=state.summary.valid&&(state.stage==Stage::Results||state.stage==Stage::Complete);
+    const bool complete=valid&&state.summary.complete;
+    char label[48],value[12];
+    if(busy){
+      if(state.stage==Stage::Heating)snprintf(label,sizeof(label),"Heating bed first");
+      else if(state.stage==Stage::Homing)snprintf(label,sizeof(label),"Homing all axes");
+      else if(state.stage==Stage::Probing)snprintf(label,sizeof(label),"Probing corner %u/4",unsigned(state.measured_count<4?state.measured_count+1:4));
+      else snprintf(label,sizeof(label),"Scan queued");
+      s.text(accent,12,278,label);s.text(dim,12,299,state.cancel_requested?"Cancel after current operation":"Click to request cancellation");button(s,12,"Cancel",true);
+    }else if(state.stage==Stage::Complete){
+      s.text(green,12,278,"Corners within tolerance");s.text(dim,12,299,"Check Z offset; rebuild mesh");button(s,12,"Remeasure",selected==4);button(s,140,"Close",selected==5);
+    }else if(valid){
+      // The one knob to turn now, in plain words
+      const uint8_t i=state.summary.adjust<4?state.summary.adjust:0;
+      const bool cw=clockwise_for_correction(state.summary.correction_mm[i],settings.cw_raises_bed);
+      if(state.summary.adjust>=4)snprintf(label,sizeof(label),"All corners OK");
+      else if(settings.direction_confirmed&&isfinite(state.summary.degrees[i]))
+        snprintf(label,sizeof(label),"%s: turn %s %ld deg",name(i),cw?"CW":"CCW",lroundf(state.summary.degrees[i]));
+      else {
+        mm(value,sizeof(value),fabsf(state.summary.correction_mm[i]));
+        snprintf(label,sizeof(label),"%s: %s %s mm",name(i),state.summary.correction_mm[i]>0?"raise":"lower",value);
+      }
+      s.text(ink,12,278,label);
+      s.text(dim,12,299,"Then press Remeasure");
+      button(s,12,"Remeasure",selected==4);button(s,140,complete?"Done":"Exit",selected==5);
+    }else{
+      s.text(state.stage==Stage::Error?red:dim,12,278,state.stage==Stage::Error?"Scan unavailable":state.stage==Stage::Cancelled?"Scan cancelled":"All four knobs are adjustable");
+      s.text(dim,12,299,state.stage==Stage::Error?(state.error?state.error:"Check configuration"):!settings.points_reachable?"Probe can't reach a corner":"Measure, adjust, then remeasure");
+      button(s,12,"Measure",selected==4);button(s,140,"Back",selected==5);
+    }
+  }
+
+  void draw_dashboard(const Surface &s,const Session &state,const uint8_t selected,const ViewSettings &settings,const bool full) {
+    const bool valid=state.summary.valid&&(state.stage==Stage::Results||state.stage==Stage::Complete);
+    const bool complete=valid&&state.summary.complete;
+    char label[48],value[12],limit[12];
+    // full: page just opened. Otherwise update in place (no blank flash): each corner card
+    // repaints its own background, so only the header and footer strips are cleared.
+    if(full)s.rectangle(true,bg,0,0,271,353);
+    else{s.rectangle(true,bg,0,31,271,95);s.rectangle(true,bg,0,273,271,353);}
+    s.rectangle(true,jnp_theme::title,0,0,271,30);
+    s.text(ink,12,7,state.stage==Stage::Complete?"Tramming complete":"Bed Tramming");
+    if(valid){
+      mm(value,sizeof(value),state.summary.spread_mm);mm(limit,sizeof(limit),settings.tolerance_mm);
+      snprintf(label,sizeof(label),"Spread %s mm (goal %s)",value,limit);s.text(complete?green:yellow,12,36,label);
+      s.text(dim,12,56,complete?"All four corners match":"Adjust one knob, then Remeasure");
+    }else{s.text(dim,12,36,"Measures all four corners");s.text(dim,12,56,"Then adjust one knob at a time");}
+    s.text(dim,120,78,"BACK");s.rectangle(false,dim,8,96,263,265);
+    for(uint8_t i=0;i<4;i++){
+      const uint16_t x=i==0||i==3?14:144,y=i<2?184:99;
+      const bool hold=valid&&state.summary.severity[i]==Severity::Acceptable;
+      const bool active=valid&&!hold&&state.summary.adjust==i;   // One knob at a time
+      const uint16_t tint=active?color(state.summary.severity[i]):hold?green:dim;
+      const bool angle=active&&isfinite(state.summary.degrees[i])&&state.summary.degrees[i]<36000;
+      const bool directed=angle&&settings.direction_confirmed;
+      const bool cw=directed&&clockwise_for_correction(state.summary.correction_mm[i],settings.cw_raises_bed);
+      s.rectangle(true,panel,x,y,x+113,y+78);s.rectangle(true,tint,x,y,x+3,y+78);
+      s.rectangle(false,selected==i?accent:panel,x-2,y-2,x+115,y+80);
+      s.text(ink,x+7,y+4,name(i));mm(value,sizeof(value),state.heights[i],true);s.text(tint,x+6,y+28,value);
+      s.text(tint,x+6,y+54,hold?"OK":!active?"":directed?(cw?"CW":"CCW"):state.summary.correction_mm[i]>0?"RAISE":"LOWER");
+      if(active||hold) knob_box(s,x+85,y+49,tint,directed,cw);
+      if(hold)snprintf(value,sizeof(value),"OK");
+      else if(angle)snprintf(value,sizeof(value),"%ld",lroundf(state.summary.degrees[i]+0.0001f));
+      else if(active)snprintf(value,sizeof(value),"?");
+      else value[0]=0;
+      if(value[0])s.text(tint,x+85-strlen(value)*4,y+41,value);
+    }
+    draw_footer(s,state,selected,settings);
+  }
+  void draw_dashboard_selection(const Surface &s,const Session &state,const uint8_t previous,
+                                const uint8_t selected,const ViewSettings &settings) {
+    for(uint8_t i=0;i<4;i++) if(i==previous||i==selected) {
+      const uint16_t x=i==0||i==3?14:144,y=i<2?184:99;
+      s.rectangle(false,i==selected?accent:bg,x-2,y-2,x+115,y+80);
+    }
+    s.rectangle(true,bg,0,273,271,353);
+    draw_footer(s,state,selected,settings);
+  }
+
+}
+#endif
