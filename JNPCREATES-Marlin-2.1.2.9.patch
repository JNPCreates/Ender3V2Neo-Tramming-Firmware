+/** Independent leveling menu and LCD adapter. SPDX-License-Identifier: GPL-3.0-or-later */
+#ifdef SMART_TRAMMING_LCD_HOST
+  #include "../../../../../tests/smart_tramming_lcd_mocks.h"
+#else
+  #include "../../../inc/MarlinConfig.h"
+#endif
+#if ALL(SMART_BED_TRAMMING, DWIN_CREALITY_LCD)
+#include "smart_tramming_lcd.h"
+#ifndef SMART_TRAMMING_LCD_HOST
+  #include "dwin.h"
+  #include "../../../module/settings.h"
+  #include "../../../gcode/queue.h"
+  #include "../../../feature/bedlevel/bedlevel.h"
+  #include "../../../module/planner.h"
+  #include "../../../module/motion.h"
+  #include "../../marlinui.h"
+  #define SMART_MESH_VIEW 1   // Live / saved mesh viewer (firmware only; not in host tests)
+#endif
+#include "../../../feature/smart_tramming.h"
+#include "../../../feature/smart_tramming_view.h"
+#include "../../../feature/smart_tramming_draw.h"
+#include "../common/jnp_theme.h"
+#include <stdio.h>
+
+namespace {
+  enum class Page : uint8_t { Menu, Paper, Dashboard, Mesh };
+  Page page = Page::Menu;
+  bool dashboard_on_screen = false;   // true while the last complete frame was the dashboard
+  uint8_t selected = 0;
+  uint16_t drawn_revision = 0;
+  smart_tramming::Stage drawn_stage = smart_tramming::Stage::Ready;
+  const char *notice = "Probe the four knob corners";
+  constexpr uint16_t bg=jnp_theme::background, ink=jnp_theme::ink;
+  smart_tramming::DrawQueue drawing;
+  uint32_t next_draw_ms=0;
+  uint8_t uncommitted=0;
+
+  void rectangle(const bool fill, const uint16_t color, const uint16_t x0,
+                 const uint16_t y0, const uint16_t x1, const uint16_t y1) {
+    drawing.add(smart_tramming::DrawCommand::Rectangle,fill,color,x0,y0,x1,y1);
+  }
+  void text(const uint16_t color, const uint16_t x, const uint16_t y, const char *label) {
+    drawing.add(smart_tramming::DrawCommand::Text,false,color,x,y,0,0,label);
+  }
+  void line(const uint16_t color, const uint16_t x0, const uint16_t y0, const uint16_t x1, const uint16_t y1) {
+    drawing.add(smart_tramming::DrawCommand::Line,false,color,x0,y0,x1,y1);
+  }
+  const smart_tramming::Surface surface { rectangle, text, line };
+  smart_tramming::ViewSettings view_settings() {
+    return { SMART_TRAMMING_TOLERANCE_MM, smart_tramming::points_reachable(),
+      bool(SMART_TRAMMING_DIRECTION_CONFIRMED), bool(SMART_TRAMMING_CW_RAISES_BED) };
+  }
+  void header(const char *title) {
+    rectangle(true,bg,0,0,271,353); rectangle(true,jnp_theme::title,0,0,271,30); text(ink,12,7,title);
+  }
+  #if SMART_MESH_VIEW
+    // ---- Bed mesh viewer: back of the bed at the top, like the tramming page ----
+    constexpr uint8_t MX=GRID_MAX_POINTS_X, MY=GRID_MAX_POINTS_Y;
+    constexpr uint16_t GX=10, GY=74, GW=252, GH=190, CW=GW/MX, CH=GH/MY;
+    float mesh_z[MX][MY];
+    uint8_t mesh_count=0;
+    bool mesh_running=false;
+
+    // "+0.12" / "-0.05" without printf float support
+    void fmt2(char *buf,const size_t size,const float v) {
+      if(!isfinite(v)){snprintf(buf,size,"--");return;}
+      const long n=_MIN(lroundf(fabsf(v)*100),9999L);   // Mesh values are far below 99.99 mm
+      snprintf(buf,size,"%c%ld.%02ld",v<-0.005f?'-':'+',n/100,n%100);
+    }
+    uint16_t mesh_color(const float z) {
+      if(!isfinite(z))return jnp_theme::panel;
+      const float a=fabsf(z);
+      return a<=0.05f?jnp_theme::green:a<=0.10f?jnp_theme::yellow:jnp_theme::red;
+    }
+    void mesh_cell(const uint8_t x,const uint8_t y) {
+      const uint16_t x0=GX+x*CW, y0=GY+(MY-1-y)*CH;
+      const float z=mesh_z[x][y];
+      rectangle(true,mesh_color(z),x0+1,y0+1,x0+CW-2,y0+CH-2);
+      if(isfinite(z)){char v[12];fmt2(v,sizeof(v),z);text(bg,x0+(CW-strlen(v)*8)/2,y0+(CH-16)/2,v);}
+    }
+    void mesh_footer() {
+      char label[40];
+      rectangle(true,bg,0,284,271,353);
+      if(mesh_running) {
+        if(mesh_count==0)snprintf(label,sizeof(label),"%s",smart_tramming::heat_before_level?"Heating bed, then homing":"Homing");
+        else snprintf(label,sizeof(label),"Probing %u/%u",unsigned(mesh_count),unsigned(MX*MY));
+        text(jnp_theme::accent,12,290,label);
+      }
+      else {
+        text(jnp_theme::muted,12,290,leveling_is_valid()?"Mesh saved and active":"No valid mesh");
+        rectangle(true,jnp_theme::accent,76,319,195,349);text(bg,84,326,"Done");
+      }
+    }
+    void draw_mesh() {
+      header(mesh_running?"Auto Mesh":"Bed Mesh");
+      float lo=NAN,hi=NAN;
+      for(uint8_t x=0;x<MX;x++)for(uint8_t y=0;y<MY;y++){
+        const float z=mesh_z[x][y];
+        if(!isfinite(z))continue;
+        if(!isfinite(lo)||z<lo)lo=z;
+        if(!isfinite(hi)||z>hi)hi=z;
+      }
+      char label[48],a[12],b[12],r[12];
+      if(isfinite(lo)){fmt2(a,sizeof(a),lo);fmt2(b,sizeof(b),hi);fmt2(r,sizeof(r),hi-lo);
+        snprintf(label,sizeof(label),"Min %s  Max %s",a,b);text(ink,12,36,label);
+        snprintf(label,sizeof(label),"Range %s mm",r+1);text(jnp_theme::muted,12,54,label);}
+      else text(jnp_theme::muted,12,36,"Waiting for the first point");
+      for(uint8_t x=0;x<MX;x++)for(uint8_t y=0;y<MY;y++)mesh_cell(x,y);
+      text(jnp_theme::muted,(272-5*8)/2,GY+GH+2,"FRONT");
+      mesh_footer();
+    }
+    void mesh_load_saved() {
+      const bool ok=leveling_is_valid();
+      for(uint8_t x=0;x<MX;x++)for(uint8_t y=0;y<MY;y++)mesh_z[x][y]=ok?bedlevel.z_values[x][y]:NAN;
+    }
+
+    // Queue a short G-code sequence without blocking the LCD loop. Coordinates given
+    // here are machine (native) positions; G-code uses logical ones (home offset).
+    bool send_gcode(const char *cmd) {
+      if(queue.has_commands_queued()||planner.has_blocks_queued()){notice="Busy - try again in a moment";return false;}
+      queue.inject(cmd); return true;
+    }
+    // Paper leveling: nozzle over a knob (the tramming spots), mesh off, lowered to Z0
+    void paper_move(const float nx,const float ny,const char *done) {
+      char cmd[64];
+      snprintf_P(cmd,sizeof(cmd),PSTR("G28O\nM420S0\nG90\nG1Z5F600\nG1X%iY%iF6000\nG1Z0F600"),
+        int(lroundf(LOGICAL_X_POSITION(nx))),int(lroundf(LOGICAL_Y_POSITION(ny))));
+      if(send_gcode(cmd))notice=done;
+    }
+    void probe_accuracy_test() {
+      char cmd[64];   // M48: 10 probes at the plate center; result goes to the status bar
+      snprintf_P(cmd,sizeof(cmd),PSTR("G28O\nM48P10X%iY%i"),
+        int(lroundf(LOGICAL_X_POSITION(Z_SAFE_HOMING_X_POINT))),int(lroundf(LOGICAL_Y_POSITION(Z_SAFE_HOMING_Y_POINT))));
+      if(send_gcode(cmd))notice="Testing - result in status bar";
+    }
+  #endif
+
+  void draw() {
+    using namespace smart_tramming;
+    drawing.clear();
+    #if SMART_MESH_VIEW
+      if (page==Page::Mesh) { draw_mesh(); return; }
+    #endif
+    const bool full = !(page==Page::Dashboard && dashboard_on_screen);
+    dashboard_on_screen = page==Page::Dashboard;
+    if (page==Page::Dashboard) {
+      draw_dashboard(surface,session,selected,view_settings(),full);
+      drawn_revision=session.revision; drawn_stage=session.stage;
+    }
+    else draw_menu(surface,MenuView{selected,notice,smart_tramming::heat_before_level,uint8_t(page==Page::Paper?1:0)});
+    if(drawing.overflow()) {
+      dashboard_on_screen=false;drawing.clear();header("Display update error");text(ink,12,60,"Select Back to leave this page");
+    }
+  }
+}
+
+bool SmartTramming_DrawingPending() { return drawing.pending(); }
+void SmartTramming_RenderTick() {
+  if(checkkey!=SmartTramming){drawing.clear();uncommitted=0;return;}
+  const uint32_t now=millis();
+  if(int32_t(now-next_draw_ms)<0)return;
+  smart_tramming::DrawCommand command;
+  if(!drawing.next(command))return;
+  if(command.kind==smart_tramming::DrawCommand::Text)
+    DWIN_Draw_String(false,font8x16,command.color,bg,command.x0,command.y0,command.label,32);
+  else DWIN_Draw_Rectangle(command.fill?1:0,command.color,command.x0,command.y0,command.x1,command.y1);
+  // No delay()/idle(): return to normal heater servicing and encoder polling.
+  // One small command every 4 ms. 2 ms corrupted the TJC panel on the printer
+  // (garbled fill rectangles), so keep 4 ms and draw fewer commands instead.
+  next_draw_ms=millis()+4;
+  if(++uncommitted>=8||!drawing.pending()){DWIN_UpdateLCD();uncommitted=0;}
+}
+
+void SmartTramming_MenuOpen() {
+  dashboard_on_screen=false;
+  page=Page::Menu; selected=1; notice="Probe the four knob corners"; checkkey=SmartTramming; draw();
+}
+void SmartTramming_Open() {
+  dashboard_on_screen=false;
+  smart_tramming::begin(); page=Page::Dashboard; selected=4; checkkey=SmartTramming; draw();
+}
+void SmartTramming_Update() {
+  using namespace smart_tramming;
+  const EncoderState event=get_encoder_state();
+  const bool turn=event==ENCODER_DIFF_CW||event==ENCODER_DIFF_CCW;
+  const bool enter=event==ENCODER_DIFF_ENTER;
+  if(page==Page::Menu||page==Page::Paper) {
+    constexpr uint8_t count=MENU_ITEMS;
+    if(turn)selected=(selected+(event==ENCODER_DIFF_CW?1:count-1))%count;
+    else if(enter&&page==Page::Menu) {
+      switch(selected) {
+        case 0: SmartTramming_Return(); return;
+        case 1: SmartTramming_Open(); return;
+        case 2:
+          #if SMART_MESH_VIEW
+            SmartMesh_Start();
+          #else
+            checkkey=Leveling;HMI_Leveling();
+          #endif
+          return;
+        case 3:
+          #if SMART_MESH_VIEW
+            SmartMesh_View(); return;
+          #else
+            notice="View Mesh: firmware only"; break;
+          #endif
+        case 4:
+          heat_before_level=!heat_before_level;
+          notice=settings.save()?(heat_before_level?"Heat bed first: ON (saved)":"Heat bed first: OFF (saved)")
+                                :"Changed, but saving failed";
+          break;
+        case 5: page=Page::Paper; selected=1; notice="Pick a knob; Home first if needed"; break;
+        case 6:
+          #if SMART_MESH_VIEW
+            probe_accuracy_test();
+          #else
+            notice="Probe test: firmware only";
+          #endif
+          break;
+      }
+    }
+    else if(enter) {   // Paper Leveling page
+      if(selected==0){end();SmartTramming_MenuOpen();return;}   // knobs may have moved: re-home Z later
+      #if SMART_MESH_VIEW
+        if(selected==1){if(send_gcode("G28"))notice="Homing";}
+        else if(selected<=5){
+          const Point &p=positions[selected-2];
+          paper_move(p.x,p.y,corner_name(selected-2));
+        }
+        else paper_move(Z_SAFE_HOMING_X_POINT,Z_SAFE_HOMING_Y_POINT,"Center");
+      #else
+        notice="Paper move: firmware only";
+      #endif
+    }
+    if(turn||enter)draw();
+    return;
+  }
+  #if SMART_MESH_VIEW
+    if(page==Page::Mesh) {
+      if(!mesh_running&&enter)SmartTramming_MenuOpen();   // Done
+      return;
+    }
+  #endif
+  bool changed=drawn_revision!=session.revision;
+  if(busy()){if(enter)cancel();}
+  else if(turn){
+    const uint8_t previous=selected;
+    selected=selected==4?5:4;   // Only the two buttons are selectable
+    if(!drawing.pending()&&!changed) {
+      drawing.clear();draw_dashboard_selection(surface,session,previous,selected,view_settings());
+      return;
+    }
+    changed=true;
+  }
+  else if(enter) {
+    if(selected==4) request_scan();
+    else {end();SmartTramming_MenuOpen();return;}   // Done/Exit leaves at once; Z re-homed later
+    changed=true;
+  }
+  if(changed||drawn_revision!=session.revision)draw();
+}
+
+#if SMART_MESH_VIEW
+  void SmartMesh_Start() {
+    dashboard_on_screen=false;
+    for(uint8_t x=0;x<MX;x++)for(uint8_t y=0;y<MY;y++)mesh_z[x][y]=NAN;
+    mesh_count=0; mesh_running=true; page=Page::Mesh; checkkey=SmartTramming; draw();
+    if(smart_tramming::heat_before_level) {   // Mesh at printing temperature (PLA preheat bed)
+      char cmd[64];
+      snprintf_P(cmd,sizeof(cmd),PSTR("M190S%i\nG28O\nG29" TERN_(EEPROM_SETTINGS, "\nM500")),int(ui.material_preset[0].bed_temp));
+      queue.inject(cmd);
+    }
+    else queue.inject(F("G28O\nG29" TERN_(EEPROM_SETTINGS, "\nM500")));   // Home if needed, probe, save
+  }
+  void SmartMesh_View() {
+    dashboard_on_screen=false;
+    mesh_load_saved(); mesh_count=MX*MY; mesh_running=false; page=Page::Mesh; checkkey=SmartTramming; draw();
+  }
+  void SmartMesh_Point(const uint8_t x, const uint8_t y, const float z) {
+    if(x>=MX||y>=MY)return;
+    mesh_z[x][y]=z; ++mesh_count;
+    if(checkkey!=SmartTramming||page!=Page::Mesh)return;
+    if(drawing.overflow())return;
+    mesh_cell(x,y); mesh_footer();   // Paced: drawn a little each idle tick while G29 moves
+  }
+  bool SmartMesh_Done() {
+    if(checkkey!=SmartTramming||page!=Page::Mesh||!mesh_running)return false;
+    mesh_running=false; mesh_load_saved(); draw();   // Final grid includes extrapolated edges
+    return true;
+  }
+#endif
+#endif
