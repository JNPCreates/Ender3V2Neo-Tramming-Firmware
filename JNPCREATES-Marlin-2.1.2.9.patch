+/** Portable Smart Tramming dashboard. SPDX-License-Identifier: GPL-3.0-or-later */
+#pragma once
+#include "smart_tramming_types.h"
+
+namespace smart_tramming {
+  // RGB565 colors and the small subset of primitives shared by supported LCDs.
+  struct Surface {
+    void (*rectangle)(bool fill, uint16_t color, uint16_t x0, uint16_t y0, uint16_t x1, uint16_t y1);
+    void (*text)(uint16_t color, uint16_t x, uint16_t y, const char *text);
+    void (*line)(uint16_t color, uint16_t x0, uint16_t y0, uint16_t x1, uint16_t y1);
+  };
+
+  struct ViewSettings {
+    float tolerance_mm;
+    bool points_reachable, direction_confirmed, cw_raises_bed;
+  };
+
+  // page 0 = Leveling: Back, Bed Tramming, Auto Mesh, View Mesh, Heat bed first, Paper Leveling, Probe Accuracy Test
+  // page 1 = Paper Leveling: Back, Home, Front Left, Front Right, Back Right, Back Left, Center
+  struct MenuView {
+    uint8_t selected;
+    const char *notice;
+    bool heat_before_level;
+    uint8_t page;
+  };
+  constexpr uint8_t MENU_ITEMS = 7;
+  void draw_menu(const Surface &surface,const MenuView &view);
+
+  // 0..3 select corners; 4 = measure/remeasure; 5 = back/done.
+  void draw_dashboard(const Surface &surface, const Session &state,
+                      uint8_t selected, const ViewSettings &settings, bool full = true);
+  void draw_dashboard_selection(const Surface &surface,const Session &state,uint8_t previous,
+                                uint8_t selected,const ViewSettings &settings);
+}
